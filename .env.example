# Copy to .env.local (git-ignored). Every key is optional: a capability without its keys stays in demo mode
# or refuses with a clear message. Nothing here is ever sent to the browser except NEXT_PUBLIC_* values.

# ---- Web app (client, not secret) ----
# Comma list of capabilities to run live: intake,research,calls,finance (or all). Empty = labeled demo mode.
NEXT_PUBLIC_MELA_LIVE=

# ---- Claude: intake, lead/outreach/quote/finance agents, translation, research extraction ----
ANTHROPIC_API_KEY=

# ---- Agent flow: store and phones ----
MELA_STORE=data/store.json
# The host's phone for a live run (E.164). The iMessage poller forwards only this number's replies.
MELA_HOST_PHONE=
# Where scripts/imessage-poll.ts posts inbound texts (default http://localhost:3000)
MELA_API=
# Seed vendors ship with placeholder 555 numbers. Point one at a real, consenting phone to call it.
VENDOR_PHONE_venue-casa-verde=
VENDOR_PHONE_cater-la-mesa=
VENDOR_PHONE_decor-flor=

# ---- Cartesia voice ----
CARTESIA_API_KEY=
# Agent flow (outbound calls through managed agents). `npm run cartesia:setup -- --write` fills these in.
CARTESIA_AGENT_ID=
CARTESIA_AGENT_ID_EN=
CARTESIA_AGENT_ID_HI=
CARTESIA_AGENT_ID_PA=
CARTESIA_AGENT_ID_VI=
CARTESIA_PHONE_NUMBER_ID=
# Optional voices; per-language ids override CARTESIA_VOICE_ID
CARTESIA_VOICE_ID=
CARTESIA_VOICE_ID_HI=
CARTESIA_VOICE_ID_PA=
CARTESIA_VOICE_ID_VI=
# Web app speech (TTS model, default sonic-3.6)
CARTESIA_TTS_MODEL=
# Host-approved call plans (/api/calls): the number to dial from (ap_...), and the one consenting phone to call
CARTESIA_FROM_NUMBER_ID=
MELA_ROLEPLAY_PHONE=
MELA_ROLEPLAY_LABEL=
CARTESIA_WEBHOOK_SECRET=

# ---- Stripe: test mode only (sk_test_... or rk_test_...); live keys are refused ----
STRIPE_SECRET_KEY=
# Optional: a hand-made connected account per vendor, otherwise the agent creates an Express account
# STRIPE_ACCT_venue-casa-verde=acct_...

# ---- CRS (StitchCredit) sandbox: vendor risk checks. Unset = every check records "review" ----
CRS_USERNAME=
CRS_PASSWORD=
CRS_BASE_URL=
CRS_CONFIG=
# OFAC / business search (host-approved finance flow)
CRS_XGS_CONFIG=
CRS_XGS_GLB_PURPOSE=
CRS_XGS_DL_PURPOSE=
CRS_XGS_SEARCH_TYPE=

# ---- Research: Bright Data (zone *names*, not keys) and Apify ----
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_SERP_ZONE=
APIFY_TOKEN=
RESEARCH_CACHE_DIR=
RESEARCH_LLM_MODEL=

# ---- Texting bridge (only when the backend runs off the Mac): SpacetimeDB between the app and relay/mac-relay.ts ----
SPACETIMEDB_URI=
SPACETIMEDB_MODULE=
SPACETIMEDB_TOKEN=
RELAY_SPACETIMEDB_TOKEN=
